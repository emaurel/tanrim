# Required
ANTHROPIC_API_KEY=

# ---- Agency identity (required before ANY outreach can be sent) ----
# Cold B2B outreach needs a real, identifiable sender and a working opt-out.
# Echo refuses to raise a send-approval card until these two are set.
TANRIM_AGENCY_NAME=
TANRIM_SENDER_EMAIL=
TANRIM_AGENCY_ADDRESS=

# What Scribe quotes for a spec site, in whole currency units.
TANRIM_QUOTE_AMOUNT=450
# What the work is worth, before the domain — which is a pass-through cost
# added on top. The appraisal at the Ledger recommends a figure inside the
# floor and ceiling; the bounds decide, the appraisal advises.
TANRIM_MARGIN_EUR=500
TANRIM_MARGIN_FLOOR_EUR=200
TANRIM_MARGIN_CEILING_EUR=500
TANRIM_QUOTE_CURRENCY=EUR

# ---- Mail: sending and receiving ----
#
# Use a domain you can afford to burn, NOT your main one. Cold outreach
# deliverability can go badly, and you do not want that reputation attached to
# the address people reach you on.
#
# Whatever provider you pick needs plain SMTP + IMAP with an APP PASSWORD.
# OAuth is not usable here: this runs headless and cannot do a browser redirect.
#
# Before sending a single email, set SPF, DKIM and DMARC on the sending domain.
# Without them cold mail lands in spam and the whole pipeline is decorative.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Receiving. Leave blank to reuse the SMTP account, which is the usual case.
# With these set, replies are fetched automatically, attachments are stored in
# the lead's asset store, and Echo reads what the reply said.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
TANRIM_MAIL_POLL_MINUTES=5

# Silence is a no. A contacted lead with no reply after this many days is lost.
# Counted from the last message that actually reached their inbox.
TANRIM_NO_REPLY_DAYS=21

# ---- Following up ----
# Days after the FIRST email to offer each follow-up. One entry per touch, so
# "3,10" means a nudge at day 3 and a final note at day 10. Counting from the
# first send rather than the previous one keeps the sequence's shape when a
# queue is cleared late.
TANRIM_FOLLOWUP_DAYS=3,10
# The pitch plus this many follow-ups, and no more. 0 turns the whole thing off.
TANRIM_MAX_FOLLOWUPS=2
# Never two messages closer together than this, whatever the schedule says.
TANRIM_FOLLOWUP_MIN_GAP_DAYS=2

# ---- Handing a sold site to the editor ----
# Once a business has paid, `tanrim.siteeditor` creates their account on
# site_editor and imports the site they bought, so they can edit it themselves.
# Neither value has a default: a wrong URL here would post a real client's site
# to somebody else's server, and the token can create accounts and read every
# client. See ../site_editor/docs/HANDOVER.md.
#
# While the editor runs on 127.0.0.1 the account is still created, but the
# welcome email is NOT sent — a loopback login link only opens on this machine,
# and a customer who has just paid should not receive one.
SITE_EDITOR_URL=
SITE_EDITOR_ADMIN_TOKEN=

# ---- Hosting ----
# Cloudflare Pages. With these set, an approved preview deploys to a public
# <slug>.pages.dev URL that the business can actually open — without them the
# preview link is 127.0.0.1 and the outreach step is a dead end.
#
# The token needs, at minimum:
#   Account -> Cloudflare Pages -> Edit
# and, once you attach a real domain:
#   Zone -> DNS -> Edit  and  Zone -> Zone -> Read
# Note Pages is an ACCOUNT permission, not a Zone one.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Fallback used when Cloudflare isn't configured.
TANRIM_PREVIEW_BASE=http://127.0.0.1:8765/preview

# Server
TANRIM_HOST=127.0.0.1
TANRIM_PORT=8765

# ---- Invoicing identity ----
# The LEGAL person and their SIRET, which is not the same as the agency name
# the outreach signs off as. A facture must carry these.
TANRIM_LEGAL_NAME=
TANRIM_SIRET=
# Full address, with postcode and town — a street alone is not compliant.
TANRIM_LEGAL_ADDRESS=
TANRIM_IBAN=
TANRIM_BIC=
TANRIM_BANK_NAME=
# 0 = payable on receipt.
TANRIM_PAYMENT_TERMS_DAYS=0
# Mandatory mention. A micro-entrepreneur under the franchise en base uses
# 293 B; an intra-EU or export mention on a domestic invoice is the wrong
# article, so this is explicit rather than assumed.
TANRIM_VAT_MENTION=TVA non applicable, article 293 B du CGI
# Invoice series. Distinct series are allowed as long as each is continuous and
# chronological, so this work numbers separately from any other invoicing you
# do — TANRIM-2026-001, -002, ... with no holes.
TANRIM_INVOICE_PREFIX=TANRIM

# ---- Domain pricing (OVH) ----
# Without these the quote falls back to a per-TLD table, which cannot see that
# a particular name is a premium domain — the same .fr can be 9 EUR or 2000.
# Create a token at https://api.ovh.com/createToken/ granting ONLY:
#   POST /order/cart   GET /order/cart/*   POST /order/cart/*
# That is read-only pricing: it cannot buy anything or touch the account.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_SUBSIDIARY=FR

# ---- Google (optional, one key unlocks two things) ----
# Enable BOTH on the Google Cloud project:
#   Street View Static API  — a real photograph of the shopfront, from a
#     documented API rather than a page that gets redesigned. The metadata
#     check is free; images bill per request.
#   Places API (New)        — the Business Profile: the listing the business
#     itself maintains. It answers the three things this pipeline has most
#     often got wrong — do they already have a website, when are they open,
#     and are they still trading. Billed per request and tiered by the fields
#     you ask for, so the field mask is kept tight.
# Without the key both stay inert and say so; neither absence is ever read as
# "they have no website".
GOOGLE_MAPS_API_KEY=

# Where a draft is relayed when the business has no email of its own — your own
# address. You forward it, or paste it into a DM. Leave unset to keep those
# drafts in the Communications panel only.
TANRIM_OPERATOR_EMAIL=
