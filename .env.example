# The environment's own settings. Six, because the environment does six
# things: it talks to a model, it serves HTTP, it runs an orchestrator, and it
# prices what it spent.
#
# EVERYTHING ELSE BELONGS TO A PLUGIN. A plugin reads the same process
# environment, so its variables go in this file too once you install one —
# see that plugin's own README or its `.env.example` for what they are.

# Required.
ANTHROPIC_API_KEY=

# Where the server listens. The app defaults to the same.
TANRIM_HOST=127.0.0.1
TANRIM_PORT=8765

# 0 turns the orchestrator off and serves the HTTP surface only, which is what
# you want when you are working on the app and do not want agents dispatching
# underneath you.
TANRIM_ORCHESTRATOR=1

# Per-model token pricing for the Treasury, as JSON. Leave unset for the
# built-in table; set it when a price changes before this does.
# TANRIM_PRICING=
# TANRIM_API_PRICING=
